# ── App ────────────────────────────────────────────────
FLOATCHAT_APP_ENV=dev
FLOATCHAT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ── PostgreSQL + PostGIS ────────────────────────────────
PG_DSN=postgresql://floatchat:floatchat_secret@localhost:5432/argo
POSTGRES_USER=floatchat
POSTGRES_PASSWORD=floatchat_secret
POSTGRES_DB=argo

# ── Qdrant (vector DB) ─────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=argo_knowledge
QDRANT_API_KEY=

# ── Redis (session memory) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Ollama (local LLM inference) ───────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_SQL_MODEL=qwen2.5:14b
OLLAMA_NARRATE_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REWRITE_MODEL=qwen2.5:3b
OLLAMA_CODE_MODEL=deepseek-coder:6.7b

# ── RAG settings ───────────────────────────────────────
RAG_TOP_K=12
RAG_BM25_WEIGHT=0.35
RAG_VECTOR_WEIGHT=0.65
RAG_RERANK_TOP_N=5
RAG_MAX_CONTEXT_TOKENS=8000

# ── Ingestion ──────────────────────────────────────────
ARGO_FTP_HOST=ftp.ifremer.fr
ARGO_FTP_PATH=/ifremer/argo/geo/indian_ocean
DATA_RAW_DIR=./data/raw
DATA_PARQUET_DIR=./data/processed

# ── Observability ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
FLOATCHAT_LOG_LEVEL=DEBUG

# -- ML: live Supabase ARGO archives (Member 3) -----------------------------
# Master switch for serving MHW forecasts / QC training from the live DBs.
VARUNA_ML_REAL_DATA=1
# ';'-separated Supabase Postgres DSNs (old archive 2022-2025 + current 2025-now).
# Get credentials from the team vault � do NOT commit real passwords.
VARUNA_ARGO_DB_URLS=postgresql://postgres.<project1>:<password>@aws-0-<region1>.pooler.supabase.com:5432/postgres;postgresql://postgres.<project2>:<password>@aws-0-<region2>.pooler.supabase.com:5432/postgres
